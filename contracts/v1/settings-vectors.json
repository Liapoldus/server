{
  "scenarios": [
    {
      "expected": {
        "accepted": true,
        "canonicalPath": "/a/b/",
        "query": "page=1"
      },
      "id": "request-path-decodes-once-and-normalizes-dot-segments",
      "input": {
        "requestTarget": "/a//b/%2e/c/../?page=1"
      }
    },
    {
      "expected": {
        "accepted": true,
        "canonicalPath": "/a/%2e%2e/b",
        "query": ""
      },
      "id": "request-path-percent-decodes-only-once",
      "input": {
        "requestTarget": "/a/%252e%252e/b"
      }
    },
    {
      "expected": {
        "accepted": false
      },
      "id": "request-path-rejects-malformed-percent-encoding",
      "input": {
        "requestTarget": "/bad%2"
      }
    },
    {
      "expected": {
        "accepted": true,
        "canonicalPath": "/search",
        "query": "q=a%2Fb"
      },
      "id": "request-path-preserves-query-separately",
      "input": {
        "requestTarget": "/search?q=a%2Fb"
      }
    },
    {
      "expected": {
        "accepted": false
      },
      "id": "configured-exact-path-rejects-dot-segments",
      "input": {
        "type": "exact",
        "value": "/a/../b"
      }
    },
    {
      "expected": {
        "accepted": false
      },
      "id": "configured-prefix-path-rejects-repeated-slashes",
      "input": {
        "type": "prefix",
        "value": "/a//b"
      }
    },
    {
      "expected": {
        "matches": true
      },
      "id": "glob-starstar-crosses-path-separators",
      "input": {
        "path": "/assets/a/b",
        "pattern": "/assets/**"
      }
    },
    {
      "expected": {
        "matches": false
      },
      "id": "glob-star-does-not-cross-path-separators",
      "input": {
        "path": "/assets/a/b",
        "pattern": "/assets/*"
      }
    },
    {
      "expected": {
        "matches": true,
        "tokens": [
          "**",
          "*"
        ]
      },
      "id": "glob-triple-star-uses-longest-tokenization",
      "input": {
        "path": "/x/a/b",
        "pattern": "/x/***"
      }
    },
    {
      "expected": {
        "accepted": true
      },
      "id": "ipv6-bind-valid-literal",
      "input": {
        "address": "[2001:db8::1]:8443"
      }
    },
    {
      "expected": {
        "accepted": false
      },
      "id": "ipv6-bind-rejects-invalid-literal",
      "input": {
        "address": "[::::]:8443"
      }
    },
    {
      "expected": {
        "location": "https://example.test/upload?q=1",
        "methodPreserved": true,
        "status": 308
      },
      "id": "automatic-https-redirect-preserves-method-and-query",
      "input": {
        "request": {
          "host": "example.test",
          "method": "POST",
          "requestTarget": "/upload?q=1"
        },
        "source": {
          "protocols": [
            "http1"
          ],
          "redirectToListenerId": "https",
          "routes": [],
          "tls": "disabled"
        },
        "target": {
          "hostnames": [
            "example.test"
          ],
          "id": "https",
          "tls": "automatic"
        }
      }
    },
    {
      "expected": {
        "location": null,
        "status": 421
      },
      "id": "automatic-https-rejects-host-outside-target-coverage",
      "input": {
        "request": {
          "host": "attacker.test",
          "requestTarget": "/"
        },
        "target": {
          "hostnames": [
            "example.test"
          ],
          "tls": "automatic"
        }
      }
    },
    {
      "expected": {
        "sequence": [
          "a",
          "a",
          "a",
          "b",
          "a",
          "a"
        ]
      },
      "id": "smooth-weighted-round-robin-honors-configured-weights",
      "input": {
        "selections": 6,
        "upstreams": [
          {
            "id": "a",
            "weight": 5
          },
          {
            "id": "b",
            "weight": 1
          }
        ]
      }
    },
    {
      "expected": {
        "failedOriginCooldownSeconds": 30,
        "maxAdditionalAttempts": 1,
        "retryAnotherOrigin": true
      },
      "id": "upstream-retry-is-limited-to-one-pre-bytes-connect-failure",
      "input": {
        "attemptedOrigins": 1,
        "failure": "tcp_connect_timeout",
        "requestBytesSent": 0
      }
    },
    {
      "expected": {
        "maxAdditionalAttempts": 0,
        "retryAnotherOrigin": false
      },
      "id": "upstream-does-not-retry-after-request-bytes",
      "input": {
        "attemptedOrigins": 1,
        "failure": "connection_reset",
        "requestBytesSent": 1
      }
    },
    {
      "expected": {
        "failedOriginCooldownSeconds": 0,
        "maxAdditionalAttempts": 0,
        "retryAnotherOrigin": false
      },
      "id": "upstream-tls-verification-failure-does-not-retry-or-exclude",
      "input": {
        "attemptedOrigins": 1,
        "failure": "tls_verification",
        "requestBytesSent": 0
      }
    }
  ],
  "semantics": "settings-semantics.json",
  "version": 1
}
