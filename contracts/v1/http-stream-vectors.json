{
  "contract": "contracts/v1/http-dispatch.json",
  "scenarios": [
    {
      "expected": {
        "idleTimeoutMillis": 60000,
        "maxConcurrentPerInstance": 128,
        "maxDurationMillis": 3600000,
        "timeoutIsIndependentFromUnary": true
      },
      "id": "http-stream-limits-defaults"
    },
    {
      "expected": {
        "extraRequestStatus": 503,
        "targetDispatch": false
      },
      "id": "http-stream-route-concurrency",
      "routeMaxConcurrency": 1
    },
    {
      "expected": {
        "stream": "close-without-replacing-response"
      },
      "id": "http-stream-idle-timeout",
      "idleTimeoutMillis": 1000,
      "responseStarted": true
    },
    {
      "activityEveryMillis": 70,
      "expected": {
        "replaceResponse": false,
        "stream": "close-at-duration-even-while-active"
      },
      "id": "http-stream-max-duration",
      "maxDurationMillis": 1800
    },
    {
      "bodyLengthDeltaFromLimit": 0,
      "expected": {
        "forwardedBytes": "maxRequestBytes",
        "requestEndSent": true,
        "response": "plugin-response"
      },
      "id": "http-stream-chunked-at-limit",
      "mode": "http_stream",
      "responseStarted": false,
      "transferEncoding": "chunked"
    },
    {
      "expected": {
        "body": "event: update\\ndata: first\\ndata: second\\nid: 17\\nretry: 1000\\n\\n",
        "contentType": "text/event-stream"
      },
      "id": "sse-structured-event-serialization",
      "input": {
        "data": "first\nsecond",
        "event": "update",
        "id": "17",
        "retry": 1000
      },
      "mode": "sse"
    },
    {
      "expected": {
        "replaceResponse": false,
        "stream": "close"
      },
      "id": "sse-invalid-event-after-response-start",
      "input": {
        "data": "safe",
        "id": "bad\\nInjected: value"
      },
      "mode": "sse"
    },
    {
      "bodyLengthDeltaFromLimit": 1,
      "expected": {
        "cancelStream": true,
        "forwardedBytes": "maxRequestBytes",
        "requestEndSent": false,
        "response": "requestTooLargeStatus"
      },
      "id": "http-stream-chunked-over-limit-before-response-start",
      "mode": "http_stream",
      "responseStarted": false,
      "transferEncoding": "chunked"
    },
    {
      "bodyLengthDeltaFromLimit": 1,
      "expected": {
        "cancelStream": true,
        "forwardedBytes": "maxRequestBytes",
        "replaceResponse": false,
        "response": "abort-stream"
      },
      "id": "http-stream-chunked-over-limit-after-response-start",
      "mode": "http_stream",
      "responseStarted": true,
      "transferEncoding": "chunked"
    },
    {
      "clientSubprotocols": [
        "forms.v1",
        "forms.v2"
      ],
      "expected": {
        "status": 101,
        "subprotocol": "forms.v1"
      },
      "id": "websocket-plugin-accepts-before-upgrade-and-selects-offered-subprotocol",
      "mode": "websocket",
      "pluginDecision": {
        "accept": true,
        "subprotocol": "forms.v1"
      }
    },
    {
      "expected": {
        "status": 403,
        "upgraded": false
      },
      "id": "websocket-plugin-rejects-before-upgrade",
      "mode": "websocket",
      "pluginDecision": {
        "accept": false,
        "status": 403
      }
    },
    {
      "clientSubprotocols": [
        "forms.v1"
      ],
      "expected": {
        "status": "invalidResponseStatus",
        "upgraded": false
      },
      "id": "websocket-unoffered-subprotocol-is-rejected-before-upgrade",
      "mode": "websocket",
      "pluginDecision": {
        "accept": true,
        "subprotocol": "forms.private"
      }
    },
    {
      "expected": {
        "boundariesPreserved": true,
        "messageCount": 2,
        "messageTypes": [
          "text",
          "binary"
        ]
      },
      "id": "websocket-text-binary-message-boundaries",
      "messages": [
        {
          "chunks": [
            "hel",
            "lo"
          ],
          "type": "text"
        },
        {
          "chunksBase64": [
            "AAEC",
            "/w=="
          ],
          "type": "binary"
        }
      ],
      "mode": "websocket"
    },
    {
      "expected": {
        "closeCode": 1009,
        "pluginReceivesOversizedMessage": false
      },
      "id": "websocket-message-over-limit-closes-with-1009",
      "messageBytes": "maxMessageBytes+1",
      "mode": "websocket"
    }
  ]
}
