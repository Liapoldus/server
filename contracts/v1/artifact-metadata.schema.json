{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liapoldus.github.io/plugins/server/v1/artifact-metadata.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "artifact", "payload"],
  "properties": {
    "version": { "const": 1 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "byteLength", "sha256"],
      "properties": {
        "mediaType": { "const": "application/gzip" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 134217728 },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "payload": {
      "description": "Server capability validates its own schema before accepting the artifact.",
      "type": "object",
      "additionalProperties": false,
      "required": ["siteId"],
      "properties": {
        "siteId": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
