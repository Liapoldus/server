{
  "manifestSchema": "site-manifest.schema.json",
  "scenarios": [
    {
      "expected": {
        "accepted": true,
        "currentPrevious": "activate-atomically-after-operation-success",
        "publicFiles": [
          "index.html"
        ],
        "resolved": {
          "/": "index.html"
        },
        "responses": {
          "/": 200,
          "/site-manifest.json": 404
        }
      },
      "id": "site-manifest-valid-archive-root",
      "input": {
        "entries": [
          {
            "path": "site-manifest.json",
            "type": "regular-file"
          },
          {
            "path": "index.html",
            "type": "regular-file"
          }
        ],
        "manifest": {
          "documentRoot": ".",
          "indexDocument": "index.html",
          "schemaVersion": 1,
          "siteId": "docs"
        },
        "payloadSiteId": "docs",
        "requests": [
          "/",
          "/site-manifest.json"
        ]
      }
    },
    {
      "expected": {
        "accepted": true,
        "resolved": {
          "/": "dist/index.html",
          "/docs/": "dist/docs/index.html"
        }
      },
      "id": "site-manifest-valid-subdirectory-root",
      "input": {
        "entries": [
          {
            "path": "site-manifest.json",
            "type": "regular-file"
          },
          {
            "path": "dist/index.html",
