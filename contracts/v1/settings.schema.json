{
  "$defs": {
    "apiParameter": {
      "additionalProperties": false,
      "properties": {
        "enum": {
          "items": {
            "maxLength": 8192,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "maxItems": {
          "maximum": 64,
          "minimum": 0,
          "type": "integer"
        },
        "maxLength": {
          "maximum": 8192,
          "minimum": 0,
          "type": "integer"
        },
        "maximum": {
          "type": "number"
        },
        "minItems": {
          "maximum": 64,
          "minimum": 0,
          "type": "integer"
        },
        "minLength": {
          "maximum": 8192,
          "minimum": 0,
          "type": "integer"
        },
        "minimum": {
          "type": "number"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        "repeated": {
          "enum": [
            "single",
            "first",
            "last",
            "repeat",
            "commaDelimited"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "string[]",
            "integer[]",
            "number[]",
            "boolean[]"
          ]
        }
      },
      "required": [
        "name",
        "type",
        "repeated",
        "required"
      ],
      "type": "object"
    },
    "apiRequestBody": {
      "additionalProperties": false,
      "properties": {
        "maxBytes": {
          "maximum": 1048576,
          "minimum": 1,
          "type": "integer"
        },
        "required": {
          "type": "boolean"
        },
        "schema": {
          "additionalProperties": true,
          "type": "object",
          "x-studio-json-document": true
        }
      },
      "required": [
        "required",
        "schema"
      ],
      "type": "object"
    },
    "apiResponse": {
      "additionalProperties": false,
      "properties": {
        "contentType": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "example": {
          "x-studio-json-value": true
        },
        "schema": {
          "additionalProperties": true,
          "type": "object",
          "x-studio-json-document": true
        },
        "status": {
          "maximum": 599,
          "minimum": 200,
          "type": "integer"
        }
      },
      "required": [
        "status",
        "contentType",
        "schema",
        "example"
      ],
      "type": "object"
    },
    "authDefault": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "enabled"
              }
            }
          },
          "then": {
            "required": [
              "scheme",
              "secretRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "basic"
              }
            }
          },
          "then": {
            "required": [
              "username"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "apiKey"
              }
            }
          },
          "then": {
            "required": [
              "headerName"
            ]
          }
        }
      ],
      "properties": {
        "headerName": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[!#$%\u0026'*+.^_`|~0-9A-Za-z-]+$",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/defaultFeatureMode"
        },
        "realm": {
          "maxLength": 128,
          "type": "string"
        },
        "scheme": {
          "enum": [
            "bearer",
            "apiKey",
            "basic"
          ],
          "type": "string"
        },
        "secretRef": {
          "description": "Opaque service-scoped secret reference. Plaintext secret values are never stored in Project settings.",
          "pattern": "^ssr:v1:[a-f0-9]{32}$",
          "type": "string",
          "x-liapoldus-secret-reference": true,
          "x-studio-secret-purpose": "server.http.auth.credential"
        },
        "username": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "Аутентификация",
      "type": "object"
    },
    "authFeature": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "enabled"
              }
            }
          },
          "then": {
            "required": [
              "scheme",
              "secretRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "basic"
              }
            }
          },
          "then": {
            "required": [
              "username"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "apiKey"
              }
            }
          },
          "then": {
            "required": [
              "headerName"
            ]
          }
        }
      ],
      "properties": {
        "headerName": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[!#$%\u0026'*+.^_`|~0-9A-Za-z-]+$",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/featureMode"
        },
        "realm": {
          "maxLength": 128,
          "type": "string"
        },
        "scheme": {
          "enum": [
            "bearer",
            "apiKey",
            "basic"
          ],
          "type": "string"
        },
        "secretRef": {
          "description": "Opaque service-scoped secret reference. Plaintext secret values are never stored in Project settings.",
          "pattern": "^ssr:v1:[a-f0-9]{32}$",
          "type": "string",
          "x-liapoldus-secret-reference": true,
          "x-studio-secret-purpose": "server.http.auth.credential"
        },
        "username": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "Аутентификация",
      "type": "object"
    },
    "cacheDefault": {
      "additionalProperties": false,
      "properties": {
        "maxAgeSeconds": {
          "default": 3600,
          "maximum": 31536000,
          "minimum": 0,
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/defaultFeatureMode"
        },
        "visibility": {
          "default": "private",
          "enum": [
            "public",
            "private"
          ],
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "Cache-Control",
      "type": "object"
    },
    "cacheFeature": {
      "additionalProperties": false,
      "properties": {
        "maxAgeSeconds": {
          "maximum": 31536000,
          "minimum": 0,
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/featureMode"
        },
        "visibility": {
          "description": "HTTP Cache-Control visibility. API routes require an explicit route-level enable before any cache header is emitted.",
          "enum": [
            "public",
            "private"
          ],
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "Cache-Control",
      "type": "object"
    },
    "compressionDefault": {
      "additionalProperties": false,
      "properties": {
        "algorithms": {
          "items": {
            "enum": [
              "zstd",
              "gzip"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "mode": {
          "$ref": "#/$defs/defaultFeatureMode"
        }
      },
      "required": [
        "mode"
      ],
      "title": "Сжатие",
      "type": "object"
    },
    "compressionFeature": {
      "additionalProperties": false,
      "properties": {
        "algorithms": {
          "description": "Compression algorithms ordered by preference. Omitted values inherit the route-type default.",
          "items": {
            "enum": [
              "zstd",
              "gzip"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "mode": {
          "$ref": "#/$defs/featureMode"
        }
      },
      "required": [
        "mode"
      ],
      "title": "Сжатие",
      "type": "object"
    },
    "config": {
      "additionalProperties": false,
      "description": "Strict Liapoldus desired settings, not native Caddy JSON or Caddyfile. Before compiling a candidate runtime configuration, SDK Reload candidate apply rejects duplicate IDs/binds, unresolved listener/site references, route/listener kind mismatches, canonical-equivalent matchers, invalid normalized paths/hosts, TLS certificate coverage errors and mode values outside the Server-supported enum. It does not preflight product methods on remote peers.",
      "properties": {
        "defaults": {
          "$ref": "#/$defs/routeDefaults",
          "description": "Shared route defaults. Each route can inherit, enable, or disable a feature without deleting its stored values."
        },
        "listeners": {
          "items": {
            "$ref": "#/$defs/listener"
          },
          "type": "array"
        },
        "routes": {
          "items": {
            "$ref": "#/$defs/route"
          },
          "type": "array"
        }
      },
      "required": [
        "listeners",
        "routes"
      ],
      "type": "object"
    },
    "corsDefault": {
      "additionalProperties": false,
      "properties": {
        "allowCredentials": {
          "type": "boolean"
        },
        "allowedHeaders": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[!#$%\u0026'*+.^_`|~0-9A-Za-z-]+$",
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "exposedHeaders": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[!#$%\u0026'*+.^_`|~0-9A-Za-z-]+$",
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "maxAgeSeconds": {
          "maximum": 86400,
          "minimum": 0,
          "type": "integer"
        },
        "methods": {
          "items": {
            "$ref": "#/$defs/method"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "mode": {
          "$ref": "#/$defs/defaultFeatureMode"
        },
        "origins": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "mode"
      ],
      "title": "CORS",
      "type": "object"
    },
    "corsFeature": {
      "additionalProperties": false,
      "properties": {
        "allowCredentials": {
          "type": "boolean"
        },
        "allowedHeaders": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[!#$%\u0026'*+.^_`|~0-9A-Za-z-]+$",
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "exposedHeaders": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[!#$%\u0026'*+.^_`|~0-9A-Za-z-]+$",
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "maxAgeSeconds": {
          "maximum": 86400,
          "minimum": 0,
          "type": "integer"
        },
        "methods": {
          "items": {
            "$ref": "#/$defs/method"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "mode": {
          "$ref": "#/$defs/featureMode"
        },
        "origins": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "mode"
      ],
      "title": "CORS",
      "type": "object"
    },
    "defaultFeatureMode": {
      "enum": [
        "enabled",
        "disabled"
      ],
      "type": "string"
    },
    "featureMode": {
      "description": "A route may inherit its handler-type default or explicitly enable/disable the feature. Values remain in Project while disabled.",
      "enum": [
        "inherit",
        "enabled",
        "disabled"
      ],
      "type": "string"
    },
    "headerMap": {
      "additionalProperties": {
        "maxLength": 8192,
        "type": "string"
      },
      "description": "Allowlisted request or response header assignments. Header names are case-insensitive; values cannot contain control characters.",
      "maxProperties": 64,
      "propertyNames": {
        "maxLength": 128,
        "pattern": "^[!#$%\u0026'*+.^_`|~0-9A-Za-z-]+$",
        "type": "string"
      },
      "type": "object"
    },
    "headersDefault": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/defaultFeatureMode"
        },
        "request": {
          "$ref": "#/$defs/headerMap"
        },
        "response": {
          "$ref": "#/$defs/headerMap"
        }
      },
      "required": [
        "mode"
      ],
      "title": "HTTP headers",
      "type": "object"
    },
    "headersFeature": {
      "$ref": "#/$defs/headersFeatureDefinition"
    },
    "headersFeatureDefinition": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/featureMode"
        },
        "request": {
          "$ref": "#/$defs/headerMap"
        },
        "response": {
          "$ref": "#/$defs/headerMap"
        }
      },
      "required": [
        "mode"
      ],
      "title": "HTTP headers",
      "type": "object"
    },
    "healthCheckDefault": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "enabled"
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          }
        }
      ],
      "properties": {
        "expectedStatus": {
          "default": 200,
          "maximum": 599,
          "minimum": 200,
          "type": "integer"
        },
        "intervalSeconds": {
          "default": 30,
          "maximum": 600,
          "minimum": 1,
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/defaultFeatureMode"
        },
        "path": {
          "default": "/healthz",
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^/[^\\r\\n\\x00]*$",
          "type": "string"
        },
        "timeoutSeconds": {
          "default": 5,
          "maximum": 60,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "mode"
      ],
      "title": "Активная проверка upstream",
      "type": "object"
    },
    "healthCheckFeature": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "enabled"
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          }
        }
      ],
      "properties": {
        "expectedStatus": {
          "default": 200,
          "maximum": 599,
          "minimum": 200,
          "type": "integer"
        },
        "intervalSeconds": {
          "default": 30,
          "maximum": 600,
          "minimum": 1,
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/featureMode"
        },
        "path": {
          "default": "/healthz",
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^/[^\\r\\n\\x00]*$",
          "type": "string"
        },
        "timeoutSeconds": {
          "default": 5,
          "maximum": 60,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "mode"
      ],
      "title": "Активная проверка upstream",
      "type": "object"
    },
    "hostname": {
      "description": "DNS hostname or a leftmost wildcard. Reload canonicalizes IDNA to a lowercase A-label without a port; a wildcard matches exactly one DNS label and never the apex.",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^(?:\\*\\.)?[^.*:/?#\\s]+(?:\\.[^.*:/?#\\s]+)*$",
      "type": "string"
    },
    "httpHandler": {
      "oneOf": [
        {
          "$ref": "#/$defs/staticHandler"
        },
        {
          "$ref": "#/$defs/reverseProxyHandler"
        },
        {
          "$ref": "#/$defs/redirectHandler"
        },
        {
          "$ref": "#/$defs/serviceHandler"
        }
      ]
    },
    "httpListener": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "hostnames": {
                "minItems": 1,
                "type": "array"
              }
            }
          },
          "if": {
            "properties": {
              "tls": {
                "properties": {
                  "mode": {
                    "const": "disabled"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "hostnames": {
                "maxItems": 0,
                "type": "array"
              },
              "protocols": {
                "const": [
                  "http1"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "redirectToListenerId"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "protocols": {
                "const": [
                  "http1"
                ]
              },
              "tls": {
                "properties": {
                  "mode": {
                    "const": "disabled"
                  }
                },
                "type": "object"
              }
            }
          }
        }
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/socketAddress"
        },
        "hostnames": {
          "description": "Explicit hostnames owned by this listener. IDNA/case-equivalent duplicates are rejected during SDK Reload candidate apply.",
          "items": {
            "$ref": "#/$defs/hostname"
          },
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "const": "http"
        },
        "protocols": {
          "description": "Explicitly enabled protocols; HTTP/3 is permitted only for automatic or custom TLS. No protocol is enabled implicitly.",
          "items": {
            "$ref": "#/$defs/httpProtocol"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "redirectToListenerId": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Optional explicit redirect-only listener target. The target must be a TLS-enabled HTTP listener with declared hostname coverage; the source listener must have no routes. The redirect source never binds implicitly."
        },
        "tls": {
          "$ref": "#/$defs/tls"
        }
      },
      "required": [
        "id",
        "kind",
        "address",
        "hostnames",
        "protocols",
        "tls"
      ],
      "type": "object"
    },
    "httpMatch": {
      "additionalProperties": false,
      "description": "All supplied predicates are combined with AND; omitted predicates are wildcards. An absent match object matches every request for the listener. Hosts are exact or a leftmost one-label wildcard, canonicalized during SDK Reload candidate apply as lowercase IDNA A-labels without ports; methods are exact case-sensitive HTTP method tokens.",
      "properties": {
        "hosts": {
          "items": {
            "$ref": "#/$defs/hostname"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "methods": {
          "items": {
            "$ref": "#/$defs/method"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "path": {
          "$ref": "#/$defs/pathMatcher"
        }
      },
      "type": "object"
    },
    "httpProtocol": {
      "enum": [
        "http1",
        "http2",
        "http3"
      ],
      "type": "string"
    },
    "httpRoute": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "not": {
              "required": [
                "api"
              ]
            }
          },
          "if": {
            "properties": {
              "handler": {
                "properties": {
                  "type": {
                    "const": "service"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            },
            "required": [
              "handler"
            ]
          },
          "then": {
            "properties": {
              "match": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "path"
                      ],
                      "type": "object"
                    },
                    {
                      "required": [
                        "methods"
                      ],
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "required": [
              "api"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "handler": {
                "properties": {
                  "mode": {
                    "enum": [
                      "http_stream",
                      "websocket",
                      "sse"
                    ]
                  }
                },
                "required": [
                  "mode"
                ],
                "type": "object"
              }
            },
            "required": [
              "handler"
            ]
          },
          "then": {
            "properties": {
              "api": {
                "properties": {
                  "body": {
                    "not": {}
                  }
                },
                "type": "object"
              }
            }
          }
        }
      ],
      "description": "Routes are evaluated in array order for their listener; the first matching route is terminal and executes exactly one handler. Supplied matcher predicates are ANDed. SDK Reload candidate apply rejects unresolved listener references, duplicate IDs/binds, canonical-equivalent matchers, invalid normalized paths/hosts, TLS certificate coverage errors and mode values outside the Server-supported enum before activation. Target peer method availability is checked only when invoked.",
      "properties": {
        "api": {
          "$ref": "#/$defs/serviceAPIContract"
        },
        "features": {
          "$ref": "#/$defs/routeFeatures",
          "description": "Optional per-route overrides. Disabled settings remain saved and can be enabled later."
        },
        "handler": {
          "$ref": "#/$defs/httpHandler"
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "listenerId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "match": {
          "$ref": "#/$defs/httpMatch"
        }
      },
      "required": [
        "id",
        "listenerId",
        "handler"
      ],
      "type": "object"
    },
    "listener": {
      "$ref": "#/$defs/httpListener"
    },
    "method": {
      "minLength": 1,
      "pattern": "^[!#$%\u0026'*+.^_`|~0-9A-Za-z-]+$",
      "type": "string"
    },
    "nonEmptyString": {
      "minLength": 1,
      "type": "string"
    },
    "pathMatcher": {
      "description": "Exactly one path mode compares against the canonical request path without query. Before matching, the request path rejects malformed percent-encoding, NUL/control and invalid UTF-8, percent-decodes exactly once, removes dot segments, collapses repeated slashes and preserves a trailing slash (including paths ending in /. or /..). exact is equality and prefix is case-sensitive prefix matching; glob and regex are full-match. exact/prefix/glob configured values are already-decoded canonical absolute paths: Reload rejects repeated slashes and literal dot segments and never percent-decodes settings. Named templates are generated internally only from a service's versioned API contract, not supplied in match. Glob tokens are read left-to-right using the longest token (** before *), so *** means ** followed by *; * matches any number of non-slash characters, ** any characters including slash, and ? exactly one non-slash character; character classes and escaping are not supported. Regex uses Go RE2 full-match over the canonical request path; its source is compiled but not path-normalized. Reload validates configured paths and compiles regex before activation.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "exact"
            },
            "value": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "prefix"
            },
            "value": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "allOf": [
            {
              "properties": {
                "value": {
                  "not": {
                    "pattern": "\\[|\\]|\\\\",
                    "type": "string"
                  }
                }
              }
            }
          ],
          "properties": {
            "type": {
              "const": "glob"
            },
            "value": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "regex"
            },
            "value": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "rateLimitDefault": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "enabled"
              }
            }
          },
          "then": {
            "required": [
              "requestsPerSecond",
              "burst"
            ]
          }
        }
      ],
      "properties": {
        "burst": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/defaultFeatureMode"
        },
        "requestsPerSecond": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "trustedProxies": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "mode"
      ],
      "title": "Ограничение частоты",
      "type": "object"
    },
    "rateLimitFeature": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "enabled"
              }
            }
          },
          "then": {
            "required": [
              "requestsPerSecond",
              "burst"
            ]
          }
        }
      ],
      "properties": {
        "burst": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/featureMode"
        },
        "requestsPerSecond": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "trustedProxies": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "mode"
      ],
      "title": "Ограничение частоты",
      "type": "object"
    },
    "redirectHandler": {
      "additionalProperties": false,
      "properties": {
        "statusCode": {
          "default": 308,
          "enum": [
            301,
            302,
            307,
            308
          ],
          "type": "integer"
        },
        "target": {
          "description": "A same-origin absolute path or an HTTP(S) URL without userinfo, query, or fragment. The original query string is preserved.",
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^(?:/[^\\r\\n\\x00]*|https?://[^/@?#\\s]+(?:/[^\\r\\n\\x00]*)?)$",
          "type": "string"
        },
        "type": {
          "const": "redirect"
        }
      },
      "required": [
        "type",
        "target",
        "statusCode"
      ],
      "title": "Перенаправление",
      "type": "object"
    },
    "reverseProxyHandler": {
      "additionalProperties": false,
      "description": "Uses per-route smooth weighted round-robin with 1–32 origins and weights 1–100 (default 1): add each eligible weight to its current weight, choose the largest (ties use array order), then subtract the eligible-weight sum from the selected origin. If the eligible set changes, current weights reset for that set. Configure active GET health probes with route.features.healthCheck. Only TCP refusal/timeout before request bytes passively excludes an origin for 30 seconds and permits at most one next-origin retry. TLS handshake/verification failure and failures after TCP connect are terminal and neither retried nor passively excluded. Once request bytes are sent, the request is never replayed.",
      "properties": {
        "type": {
          "const": "reverseProxy"
        },
        "upstreams": {
          "items": {
            "$ref": "#/$defs/upstream"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "type",
        "upstreams"
      ],
      "type": "object"
    },
    "rewriteDefault": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "enabled"
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          }
        }
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/defaultFeatureMode"
        },
        "path": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^/[^\\r\\n\\x00]*$",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "Переписывание пути",
      "type": "object"
    },
    "rewriteFeature": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "enabled"
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          }
        }
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/featureMode"
        },
        "path": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^/[^\\r\\n\\x00]*$",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "Переписывание пути",
      "type": "object"
    },
    "route": {
      "$ref": "#/$defs/httpRoute"
    },
    "routeDefaults": {
      "additionalProperties": false,
      "description": "Optional shared defaults by route handler type. Omitted defaults use safe built-in values: static routes enable compression and public max-age=3600; API and reverse-proxy routes disable compression and caching.",
      "properties": {
        "redirect": {
          "$ref": "#/$defs/routeFeatureDefaults"
        },
        "reverseProxy": {
          "$ref": "#/$defs/routeFeatureDefaults"
        },
        "service": {
          "$ref": "#/$defs/routeFeatureDefaults"
        },
        "static": {
          "$ref": "#/$defs/routeFeatureDefaults"
        }
      },
      "title": "Значения по типам маршрутов",
      "type": "object"
    },
    "routeFeatureDefaults": {
      "additionalProperties": false,
      "properties": {
        "auth": {
          "$ref": "#/$defs/authDefault"
        },
        "cache": {
          "$ref": "#/$defs/cacheDefault"
        },
        "compression": {
          "$ref": "#/$defs/compressionDefault"
        },
        "cors": {
          "$ref": "#/$defs/corsDefault"
        },
        "headers": {
          "$ref": "#/$defs/headersDefault"
        },
        "healthCheck": {
          "$ref": "#/$defs/healthCheckDefault"
        },
        "rateLimit": {
          "$ref": "#/$defs/rateLimitDefault"
        },
        "rewrite": {
          "$ref": "#/$defs/rewriteDefault"
        }
      },
      "title": "Общие значения маршрутов",
      "type": "object"
    },
    "routeFeatures": {
      "additionalProperties": false,
      "properties": {
        "auth": {
          "$ref": "#/$defs/authFeature"
        },
        "cache": {
          "$ref": "#/$defs/cacheFeature"
        },
        "compression": {
          "$ref": "#/$defs/compressionFeature"
        },
        "cors": {
          "$ref": "#/$defs/corsFeature"
        },
        "headers": {
          "$ref": "#/$defs/headersFeature"
        },
        "healthCheck": {
          "$ref": "#/$defs/healthCheckFeature"
        },
        "rateLimit": {
          "$ref": "#/$defs/rateLimitFeature"
        },
        "rewrite": {
          "$ref": "#/$defs/rewriteFeature"
        }
      },
      "title": "Обработка маршрута",
      "type": "object"
    },
    "serviceAPIContract": {
      "additionalProperties": false,
      "description": "Typed Server-owned request contract. Query, path and declared header values are parsed and validated before service dispatch. Response schemas validate examples at candidate apply and are documentation only at runtime.",
      "properties": {
        "allowUnknownHeaders": {
          "default": true,
          "type": "boolean"
        },
        "allowUnknownQuery": {
          "default": true,
          "type": "boolean"
        },
        "body": {
          "$ref": "#/$defs/apiRequestBody"
        },
        "headerParameters": {
          "items": {
            "$ref": "#/$defs/apiParameter"
          },
          "maxItems": 64,
          "type": "array"
        },
        "method": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[!#$%\u0026'*+.^_`|~0-9A-Za-z-]+$",
          "type": "string"
        },
        "path": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^/",
          "type": "string"
        },
        "pathParameters": {
          "items": {
            "$ref": "#/$defs/apiParameter"
          },
          "maxItems": 64,
          "type": "array"
        },
        "queryParameters": {
          "items": {
            "$ref": "#/$defs/apiParameter"
          },
          "maxItems": 64,
          "type": "array"
        },
        "responses": {
          "items": {
            "$ref": "#/$defs/apiResponse"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        "version": {
          "const": "server-http/v1"
        }
      },
      "required": [
        "version",
        "method",
        "path",
        "responses"
      ],
      "type": "object"
    },
    "serviceHandler": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "call"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "not": {
              "required": [
                "streamLimits"
              ]
            }
          }
        }
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "instanceId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "mode": {
          "description": "Selects a Server-supported invocation mode. Target method availability is determined by the generic peer call at invocation time; Core does not inspect product capabilities.",
          "enum": [
            "call",
            "http_stream",
            "websocket",
            "sse"
          ]
        },
        "requestCookieNames": {
          "description": "Only these request Cookie names are included in the service request context; all other cookies are omitted.",
          "items": {
            "minLength": 1,
            "pattern": "^[!#$%\u0026'*+.^_`|~0-9A-Za-z-]+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "streamLimits": {
          "additionalProperties": false,
          "description": "Optional per-route bounds for long-lived streaming modes; all limits remain subject to the per-instance ceiling. Omitted values use the versioned defaults: concurrency 128 per route and instance, idle 60000 ms, maximum duration 3600000 ms.",
          "properties": {
            "idleTimeoutMillis": {
              "maximum": 60000,
              "minimum": 1000,
              "type": "integer"
            },
            "maxConcurrency": {
              "maximum": 128,
              "minimum": 1,
              "type": "integer"
            },
            "maxDurationMillis": {
              "maximum": 3600000,
              "minimum": 1000,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "type": {
          "const": "service"
        }
      },
      "required": [
        "type",
        "instanceId",
        "capability",
        "mode"
      ],
      "type": "object"
    },
    "socketAddress": {
      "description": "An HTTP listener bind address in host:port form. Host is empty wildcard, IPv4 literal, or bracketed IPv6 literal; port is ASCII decimal 1 through 65535 without leading zero. Reload additionally validates IP literals with netip.ParseAddr and rejects IPv6 zone identifiers.",
      "pattern": "^(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])|\\[[0-9A-Fa-f:.]+\\]:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))$",
      "type": "string"
    },
    "staticHandler": {
      "additionalProperties": false,
      "description": "Serves one immutable site release at mountPrefix. releaseId is the exact sha256 revision returned by the Server release catalog; publishing a later release never changes this route.",
      "properties": {
        "mountPrefix": {
          "description": "URL path prefix. Runtime rejects dot segments and mounts the immutable release below this prefix.",
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^/(?:[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*)?/?$",
          "type": "string"
        },
        "releaseId": {
          "description": "Immutable release digest selected from the Server release catalog.",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "siteId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "const": "static"
        }
      },
      "required": [
        "type",
        "siteId",
        "releaseId",
        "mountPrefix"
      ],
      "type": "object"
    },
    "tls": {
      "oneOf": [
        {
          "$ref": "#/$defs/tlsAutomatic"
        },
        {
          "$ref": "#/$defs/tlsCustom"
        },
        {
          "$ref": "#/$defs/tlsDisabled"
        }
      ]
    },
    "tlsAutomatic": {
      "additionalProperties": false,
      "description": "Uses Caddy-managed ACME certificates for declared hostnames. HTTP redirects to HTTPS only through a separately declared plaintext redirect-only listener; no HTTP socket is opened implicitly. Effective TLS bounds are TLS 1.2 minimum and TLS 1.3 maximum; HTTP/3 is available only over TLS. HTTP-01 and TLS-ALPN-01 use built modules; DNS-01 is available only for provider modules compiled into this binary. The provider list is a build concern, not a settings field.",
      "properties": {
        "mode": {
          "const": "automatic"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "tlsCustom": {
      "additionalProperties": false,
      "description": "Uses the referenced certificate/key pair. The service resolves references only through the scoped secret-grant boundary and validates the pair before activation. Effective TLS bounds are TLS 1.2 minimum and TLS 1.3 maximum.",
      "properties": {
        "certificateRef": {
          "description": "Opaque Core-generated secret reference; never PEM bytes or a path.",
          "pattern": "^ssr:v1:[a-f0-9]{32}$",
          "type": "string",
          "x-liapoldus-secret-reference": true,
          "x-studio-secret-purpose": "server.tls.certificate"
        },
        "mode": {
          "const": "custom"
        },
        "privateKeyRef": {
          "description": "Opaque Core-generated secret reference; never PEM bytes or a path.",
          "pattern": "^ssr:v1:[a-f0-9]{32}$",
          "type": "string",
          "x-liapoldus-secret-reference": true,
          "x-studio-secret-purpose": "server.tls.private-key"
        }
      },
      "required": [
        "mode",
        "certificateRef",
        "privateKeyRef"
      ],
      "type": "object"
    },
    "tlsDisabled": {
      "additionalProperties": false,
      "description": "Explicit HTTP/1.1 plaintext listener. It cannot declare hostnames, routes with host matchers, or ACME behavior.",
      "properties": {
        "mode": {
          "const": "disabled"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "upstream": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "pattern": "^http://",
                "type": "string"
              }
            },
            "required": [
              "origin"
            ],
            "type": "object"
          },
          "then": {
            "not": {
              "required": [
                "caRef"
              ]
            }
          }
        }
      ],
      "properties": {
        "caRef": {
          "description": "Optional opaque private-CA secret reference; accepted only for HTTPS origins. It extends the system trust chain and never disables hostname verification.",
          "pattern": "^ssr:v1:[a-f0-9]{32}$",
          "type": "string",
          "x-liapoldus-secret-reference": true,
          "x-studio-secret-purpose": "server.upstream.ca"
        },
        "origin": {
          "description": "HTTP(S) origin authority only: no userinfo, path, query, or fragment. Full URL and port parsing is checked during SDK Reload candidate apply.",
          "pattern": "^https?://[^/@?#\\s]+$",
          "type": "string"
        },
        "weight": {
          "default": 1,
          "description": "Smooth weighted round-robin weight. An omitted value is interpreted as 1.",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "origin"
      ],
      "type": "object"
    }
  },
  "$id": "https://liapoldus.github.io/services/server/settings/v2/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict Liapoldus configuration compiled privately into the Caddy runtime. Native Caddy JSON and Caddyfile input are not accepted.",
  "properties": {
    "config": {
      "$ref": "#/$defs/config"
    },
    "schemaVersion": {
      "const": 2
    }
  },
  "required": [
    "schemaVersion",
    "config"
  ],
  "title": "Server service settings v2",
  "type": "object"
}
