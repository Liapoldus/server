{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liapoldus.github.io/spec/server/http-stream.v1.schema.json",
  "title": "Server plugin HTTP stream envelope contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "kindField", "dataField", "requestField", "statusField",
    "headersField", "maxChunkBytes", "maxFrameBytes", "requestStartKind",
    "requestChunkKind", "requestEndKind", "responseStartKind",
    "responseChunkKind", "responseEndKind", "websocket", "sse"
  ],
  "properties": {
    "version": { "const": 1 },
    "kindField": { "const": "kind" },
    "dataField": { "const": "data" },
    "requestField": { "const": "request" },
    "statusField": { "const": "status" },
    "headersField": { "const": "headers" },
    "maxChunkBytes": { "type": "integer", "minimum": 1 },
    "maxFrameBytes": { "type": "integer", "minimum": 1 },
    "requestStartKind": { "type": "string", "minLength": 1 },
    "requestChunkKind": { "type": "string", "minLength": 1 },
    "requestEndKind": { "type": "string", "minLength": 1 },
    "responseStartKind": { "type": "string", "minLength": 1 },
    "responseChunkKind": { "type": "string", "minLength": 1 },
    "responseEndKind": { "type": "string", "minLength": 1 },
    "websocket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxMessageBytes", "requestField", "handshakeKind", "acceptField", "subprotocolsField", "subprotocolField", "messageStartKind", "messageChunkKind", "messageEndKind", "messageTypeField", "textMessageType", "binaryMessageType", "closeKind", "codeField", "reasonField", "defaultRejectStatus"],
      "properties": {
        "maxMessageBytes": { "type": "integer", "minimum": 1 },
        "requestField": { "type": "string", "minLength": 1 },
        "handshakeKind": { "type": "string", "minLength": 1 },
        "acceptField": { "type": "string", "minLength": 1 },
        "subprotocolsField": { "type": "string", "minLength": 1 },
        "subprotocolField": { "type": "string", "minLength": 1 },
        "messageStartKind": { "type": "string", "minLength": 1 },
        "messageChunkKind": { "type": "string", "minLength": 1 },
        "messageEndKind": { "type": "string", "minLength": 1 },
        "messageTypeField": { "type": "string", "minLength": 1 },
        "textMessageType": { "type": "string", "minLength": 1 },
        "binaryMessageType": { "type": "string", "minLength": 1 },
        "closeKind": { "type": "string", "minLength": 1 },
        "codeField": { "type": "string", "minLength": 1 },
        "reasonField": { "type": "string", "minLength": 1 },
        "defaultRejectStatus": { "type": "integer", "minimum": 400, "maximum": 599 }
      }
    },
    "sse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventKind", "contentType", "contentTypeHeader", "eventField", "dataField", "idField", "retryField", "eventPrefix", "dataPrefix", "idPrefix", "retryPrefix", "lineEnding", "eventTerminator", "maxRetryMillis"],
      "properties": {
        "eventKind": { "const": "sse_event" },
        "contentType": { "const": "text/event-stream" },
        "contentTypeHeader": { "const": "Content-Type" },
        "eventField": { "const": "event" },
        "dataField": { "const": "data" },
        "idField": { "const": "id" },
        "retryField": { "const": "retry" },
        "eventPrefix": { "const": "event: " },
        "dataPrefix": { "const": "data: " },
        "idPrefix": { "const": "id: " },
        "retryPrefix": { "const": "retry: " },
        "lineEnding": { "const": "\n" },
        "eventTerminator": { "const": "\n" },
        "maxRetryMillis": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    }
  }
}
