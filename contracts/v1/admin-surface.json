{
  "pages": [
    {
      "capability": "server.sites.list",
      "id": "sites",
      "permissions": [
        "plugins.server.read"
      ],
      "sections": [
        {
          "actions": [
            {
              "artifactInput": {
                "maxBytes": 134217728,
                "maxMetadataBytes": 65536,
                "maxMultipartOverheadBytes": 65536,
                "mediaTypes": [
                  "application/gzip"
                ]
              },
              "capability": "server.sites.publish",
              "confirmation": "Проверить архив и опубликовать новую неизменяемую ревизию сайта?",
              "id": "publish",
              "inputSchema": {
                "additionalProperties": false,
                "properties": {
                  "expectedCurrentRevision": {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  },
                  "siteId": {
                    "maxLength": 128,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "siteId"
                ],
                "type": "object"
              },
              "rowInput": {
                "siteId": "siteId"
              },
              "title": "Опубликовать .tar.gz"
            },
            {
              "capability": "server.sites.rollback",
              "confirmation": "Атомарно переключить current и previous на выбранную неизменяемую ревизию?",
              "dangerous": true,
              "id": "rollback",
              "inputSchema": {
                "additionalProperties": false,
                "properties": {
                  "expectedCurrentRevision": {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  },
                  "siteId": {
                    "maxLength": 128,
                    "minLength": 1,
                    "type": "string"
                  },
                  "targetRevision": {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "siteId",
                  "expectedCurrentRevision",
                  "targetRevision"
                ],
                "type": "object"
              },
              "rowInput": {
                "expectedCurrentRevision": "currentRevision",
                "siteId": "siteId",
                "targetRevision": "previousRevision"
              },
              "title": "Откатить релиз"
            }
          ],
          "columns": [
            "siteId",
            "currentRevision",
            "previousRevision",
            "updatedAt"
          ],
          "dataCapability": "server.sites.list",
          "id": "sites",
          "kind": "table",
          "title": "Сайты"
        },
        {
          "actions": [],
          "columns": [
            "siteId",
            "revisionId",
            "state",
            "sha256",
            "createdAt"
          ],
          "dataCapability": "server.sites.releases.list",
          "id": "releases",
          "kind": "table",
          "title": "Неизменяемые ревизии"
        },
        {
          "actions": [
            {
              "capability": "server.operations.get",
              "id": "status",
              "inputSchema": {
                "additionalProperties": false,
                "properties": {
                  "operationId": {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "operationId"
                ],
                "type": "object"
              },
              "rowInput": {
                "operationId": "operationId"
              },
              "title": "Обновить состояние"
            }
          ],
          "columns": [
            "operationId",
            "siteId",
            "kind",
            "state",
            "progressPercent",
            "updatedAt"
          ],
          "dataCapability": "server.operations.list",
          "id": "operations",
          "kind": "table",
          "title": "Операции публикации"
        }
      ],
      "title": "Сайты и релизы"
    },
    {
      "capability": "server.certificates.list",
      "id": "certificates",
      "permissions": [
        "plugins.server.tls.read"
      ],
      "sections": [
        {
          "actions": [
            {
              "capability": "server.certificates.get",
              "id": "status",
              "inputSchema": {
                "additionalProperties": false,
                "properties": {
                  "domain": {
                    "maxLength": 253,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "domain"
                ],
                "type": "object"
              },
              "rowInput": {
                "domain": "domain"
              },
              "title": "Проверить домен"
            }
          ],
          "columns": [
            "domain",
            "source",
            "readiness",
            "notAfter",
            "serial"
          ],
          "dataCapability": "server.certificates.list",
          "id": "domains",
          "kind": "table",
          "title": "Домены и готовность TLS"
        }
      ],
      "title": "Сертификаты"
    }
  ],
  "plugin": "server",
  "requiredCapabilities": [
    "admin.surface.get",
    "server.sites.list",
    "server.sites.releases.list",
    "server.sites.rollback",
    "server.sites.publish",
    "server.operations.list",
    "server.operations.get",
    "server.certificates.list",
    "server.certificates.get"
  ],
  "version": 1
}
