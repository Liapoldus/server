{
  "$defs": {
    "action": {
      "additionalProperties": false,
      "properties": {
        "artifactInput": {
          "$ref": "#/$defs/artifactInput"
        },
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "confirmation": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "dangerous": {
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/pageId"
        },
        "inputSchema": {
          "$ref": "#/$defs/actionInputSchema"
        },
        "rowInput": {
          "additionalProperties": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "minProperties": 1,
          "type": "object"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "capability",
        "inputSchema"
      ],
      "type": "object"
    },
    "actionInputSchema": {
      "additionalProperties": false,
      "properties": {
        "additionalProperties": {
          "const": false
        },
        "properties": {
          "additionalProperties": {
            "$ref": "#/$defs/inputField"
          },
          "type": "object"
        },
        "required": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "type": {
          "const": "object"
        }
      },
      "required": [
        "type",
        "properties",
        "required",
        "additionalProperties"
      ],
      "type": "object"
    },
    "artifactInput": {
      "additionalProperties": false,
      "properties": {
        "maxBytes": {
          "maximum": 134217728,
          "minimum": 1,
          "type": "integer"
        },
        "maxMetadataBytes": {
          "maximum": 65536,
          "minimum": 2,
          "type": "integer"
        },
        "maxMultipartOverheadBytes": {
          "maximum": 65536,
          "minimum": 0,
          "type": "integer"
        },
        "mediaTypes": {
          "items": {
            "maxLength": 127,
            "pattern": "^[a-z0-9!#$%\u0026'*+.^_`|~-]+/[a-z0-9!#$%\u0026'*+.^_`|~-]+$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "mediaTypes",
        "maxBytes",
        "maxMetadataBytes",
        "maxMultipartOverheadBytes"
      ],
      "type": "object"
    },
    "capability": {
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "type": "string"
    },
    "columnId": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$",
      "type": "string"
    },
    "detailSection": {
      "additionalProperties": false,
      "properties": {
        "dataCapability": {
          "$ref": "#/$defs/capability"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/field"
          },
          "minItems": 1,
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/pageId"
        },
        "kind": {
          "const": "detail"
        },
        "title": {
          "maxLength": 120,
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "dataCapability",
        "fields"
      ],
      "type": "object"
    },
    "field": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 1024,
          "type": "string"
        },
        "key": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "required": {
          "type": "boolean"
        },
        "title": {
          "maxLength": 120,
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "select",
            "multiselect",
            "secret",
            "file",
            "directory",
            "duration",
            "size",
            "code",
            "keyValue",
            "array",
            "object"
          ]
        }
      },
      "required": [
        "key",
        "type"
      ],
      "type": "object"
    },
    "inputField": {
      "additionalProperties": false,
      "properties": {
        "enum": {
          "items": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "maxLength": {
          "minimum": 0,
          "type": "integer"
        },
        "maximum": {
          "type": "number"
        },
        "minLength": {
          "minimum": 0,
          "type": "integer"
        },
        "minimum": {
          "type": "number"
        },
        "type": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "nonEmptyString": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "page": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "id": {
          "$ref": "#/$defs/pageId"
        },
        "permissions": {
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "type": "array",
          "uniqueItems": true
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/section"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "capability",
        "sections"
      ],
      "type": "object"
    },
    "pageId": {
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "type": "string"
    },
    "section": {
      "oneOf": [
        {
          "$ref": "#/$defs/tableSection"
        },
        {
          "$ref": "#/$defs/detailSection"
        }
      ]
    },
    "tableSection": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/action"
          },
          "type": "array"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/columnId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "dataCapability": {
          "$ref": "#/$defs/capability"
        },
        "id": {
          "$ref": "#/$defs/pageId"
        },
        "kind": {
          "const": "table"
        },
        "title": {
          "maxLength": 120,
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "dataCapability",
        "columns",
        "actions"
      ],
      "type": "object"
    }
  },
  "$id": "https://liapoldus.github.io/plugins/server/admin-ui/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict declarative plugin administration surface. It contains no executable UI, URL, listener, or secret value.",
  "properties": {
    "pages": {
      "items": {
        "$ref": "#/$defs/page"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "plugin": {
      "const": "server"
    },
    "requiredCapabilities": {
      "items": {
        "$ref": "#/$defs/capability"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "version",
    "plugin",
    "requiredCapabilities",
    "pages"
  ],
  "title": "Server plugin Admin Surface v1",
  "type": "object"
}
