{
  "app": "liapoldus.dispatch",
  "blockedHeaders": [
    "Connection",
    "Keep-Alive",
    "Proxy-Authenticate",
    "Proxy-Authorization",
    "TE",
    "Trailer",
    "Transfer-Encoding",
    "Upgrade",
    "Authorization"
  ],
  "cookieHeader": "Cookie",
  "defaultStreamIdleTimeoutMillis": 60000,
  "defaultStreamMaxDurationMillis": 3600000,
  "defaultTimeoutMillis": 5000,
  "headerLimitModule": "http.handlers.liapoldus_request_header_limit",
  "invalidRequestStatus": 400,
  "invalidResponseStatus": 502,
  "maxRequestBytes": 1048576,
  "maxRequestHeaderBytes": 65536,
  "maxStreamConcurrencyPerInstance": 128,
  "module": "http.handlers.liapoldus_service",
  "requestBodySemantics": {
    "chunkedIncluded": true,
    "count": "body-octets-after-transfer-framing",
    "modes": [
      "call",
      "http_stream",
      "sse"
    ],
    "overflowAfterResponseStart": "abort-stream-without-replacing-response",
    "overflowBeforeResponseStart": "requestTooLargeStatus-and-cancel-stream"
  },
  "requestHeaderByteSemantics": "each parsed field name, colon-space, value, and CRLF; includes Host; excludes request line and final empty line",
  "requestHeaderTooLargeStatus": 431,
  "requestIDHeader": "X-Request-ID",
  "requestParameters": {
    "bodySemantics": "If a route declares a JSON body schema, body bytes are validated against it and copied unchanged into parameters.body. If omitted, a non-empty unary body is rejected. Stream modes continue to carry their bounded body frames outside parameters.body.",
    "field": "parameters",
    "schema": "contracts/v1/http-request-parameters.schema.json",
    "validation": "Server parses and validates typed path, query and declared header values before invoking a service; malformed or invalid requests receive a generic 400 and are not dispatched.",
    "values": [
      "path",
      "query",
      "headers",
      "body"
    ],
    "version": "server-http/v1"
  },
  "requestTooLargeStatus": 413,
  "responseCookies": {
    "field": "cookies",
    "maxAgeMinimum": -1,
    "sameSiteNoneRequiresSecure": true,
    "sameSiteValues": [
      "lax",
      "strict",
      "none"
    ],
    "schema": "http-response-action.schema.json",
    "validateAllBeforeHeaders": true
  },
  "setCookieHeader": "Set-Cookie",
  "streamTimeoutStatus": 504,
  "unavailableStatus": 503
}
