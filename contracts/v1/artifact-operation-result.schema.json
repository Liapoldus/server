{
  "$id": "https://liapoldus.github.io/plugins/server/v1/artifact-operation-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "operationId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "state": {
      "const": "accepted"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "version",
    "operationId",
    "state"
  ],
  "type": "object"
}
